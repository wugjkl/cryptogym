<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="de.cryptogym.ui.CryptoGymFxViewController">
    <padding>
        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0"/>
    </padding>

    <HBox spacing="12.0">
        <Label text="Algorithm:"/>
        <ComboBox fx:id="algorithmComboBox" prefWidth="130.0"/>
        <Label text="Mode:"/>
        <ComboBox fx:id="modeComboBox" prefWidth="110.0"/>
        <Label text="Padding:"/>
        <ComboBox fx:id="paddingComboBox" prefWidth="180.0"/>
    </HBox>

    <HBox spacing="10.0">
        <Label text="Plaintext (String):"/>
        <Label fx:id="plaintextBytesLabel" text="0 Bytes"/>
    </HBox>
    <TextArea fx:id="plaintextArea" prefRowCount="2" promptText="Enter plaintext string..."/>

    <Label text="Plaintext (Hex):"/>
    <TextArea fx:id="plaintextHexArea" prefRowCount="2" promptText="Enter or view plaintext in hex..."/>

    <HBox spacing="10.0">
        <Label text="Ciphertext (Hex):"/>
        <Label fx:id="ciphertextBytesLabel" text="0 Bytes"/>
    </HBox>
    <TextArea fx:id="ciphertextHexArea" prefRowCount="2" promptText="Enter or view ciphertext in hex..."/>

    <HBox spacing="10.0">
        <Label text="Key (Hex):"/>
        <TextField fx:id="keyHexField" HBox.hgrow="ALWAYS" promptText="000102030405060708090a0b0c0d0e0f"/>
        <Label fx:id="keyBytesLabel" text="0 Bytes"/>
        <Button text="Generate Key" onAction="#handleGenerateKey"/>
    </HBox>

    <HBox spacing="10.0">
        <Label text="IV (Hex):"/>
        <TextField fx:id="ivHexField" HBox.hgrow="ALWAYS" promptText="0102030405060708090a0b0c0d0e0f10"/>
        <Label fx:id="ivBytesLabel" text="0 Bytes"/>
        <Button text="Generate IV" onAction="#handleGenerateIv"/>
    </HBox>

    <HBox spacing="12.0">
        <Button text="Encrypt" onAction="#handleEncrypt" prefWidth="110.0"/>
        <Button text="Decrypt" onAction="#handleDecrypt" prefWidth="110.0"/>
        <Button text="Reset" onAction="#handleReset" prefWidth="110.0"/>
    </HBox>

    <HBox spacing="10.0">
        <Label text="Status:"/>
        <TextField fx:id="statusField" editable="false" HBox.hgrow="ALWAYS"/>
    </HBox>
</VBox>
